# =========================
# LOAD PACKAGES
# =========================
load_or_install_package("shiny")
load_or_install_package <- function(package) {
if (!require(package, character.only = TRUE)) {
install.packages(package, repos = "https://cloud.r-project.org")
library(package, character.only = TRUE)
}
}
load_package <- function(package) {
if (!require(package, character.only = TRUE)) {
install.packages(package, repos = "https://cloud.r-project.org")
library(package, character.only = TRUE)
}
}
# =========================
# LOAD PACKAGES
# =========================
load_package("shiny")
devtools::document()
devtools::check()
devtools::check()
devtools::install()
devtools::install()
### INSTALL "REMOTES" IF NOT INSTALLED
if(!require("remotes")) install.packages("remotes", repos = "https://cloud.r-project.org" )
library(remotes)
### INSTALL "estatisticapesqueiraSTP" IF NOT INSTALLED
if(!require(estatisticapesqueiraSTP))
remotes::install_github("gporrinos/estatisticapesqueiraSTP", upgrade = "never")
### FUNCTION TO CHECK WHETHER GITHUB PACKAGES NEED UPDATE
needs_update <- function(package, repository) {
### STEP 1. GET LOCAL VERSION
local_version <- tryCatch(packageVersion(package),
error = function(e) NULL
)
if(is.null(local_version)) return(TRUE)      # Package not installed, needs installation
### STEP 2. QUERY GITHUB API FOR 'DESCRIPTION' FILE
res = tryCatch(readLines(paste0("https://raw.githubusercontent.com/",
repository,
"/HEAD/DESCRIPTION"),
warn = FALSE),
error = function(e) NULL
)
if(is.null(res)){
message("Could not reach GitHub, skipping update check for ", package)
return(FALSE)      # Skip update
}
### STEP 3. PARSE VERSION LINE FROM 'DESCRIPTION'
version_line = grep("^Version:", res, value = TRUE)
if(length(version_line) == 0) {
message("Could not parse version of ", repository, ", skipping update check for ", package)
return(FALSE)      # Skip update
}
### STEP 4. PARSE VERSION FIELD FROM 'version_line'
remote_version =
tryCatch(
package_version(trimws(
sub("^Version:", "", version_line)
)),
error = function(e) NULL
)
if(is.null(remote_version)){
message("Could not parse version of ", repository, ", skipping update check for ", package)
return(FALSE)      # Skip update
}
### STEP 5. COMPARE LOCAL AND REMOTE VERSION
return(local_version < remote_version)
}
### INSTALL ESTATISTICAPESQUEIRASTP
if (needs_update("estatisticapesqueiraSTP", "gporrinos/estatisticapesqueiraSTP")) {
remotes::install_github("gporrinos/estatisticapesqueiraSTP", upgrade = "never")
}
### SOURCE SCRIPTS TO LOAD OR INSTALL PACKAGES
source(system.file("scripts", "package_functions.R", package = "estatisticapesqueiraSTP"))
source(system.file("scripts", "load_install_packages.R", package = "estatisticapesqueiraSTP"))
start_interface()
#' @export
start_interface <- function(){
config_path <- system.file(config, package = "estatisticapesqueiraSTP")
conf <- estatisticapesqueiraSTP::get_config_from_local(config = config_path)
artfish <- list(
dat = readxl::read_excel(path = file.path(config_path, "artfish.xlsx"), sheet = "dat"),
vars = readxl::read_excel(path = file.path(config_path, "artfish.xlsx"),
sheet = "vars"))
shiny::shinyApp(ui     = estatisticapesqueiraSTP::create_ui("Estatistica pesqueira STP"),
server = estatisticapesqueiraSTP::create_server(
wd = NULL,
cache = NULL,
last_session = NULL,
local_data_directory = conf$config$local_data_directory,
repository_name = conf$repository_name,
repository_location = conf$repository_location,
forms = conf$forms,
databases = conf$databases,
variables = conf$variables,
config = conf$config,
cleaning_function = conf$cleaning_function,
zenodo = conf$zenodo,
artfish = artfish
),
options = list(launch.browser = TRUE)
)
}
start_interface()
start_interface()
start_interface()
system.file("config", package = "estatisticapesqueiraSTP")
start_interface()
config_path <- system.file("config", package = "estatisticapesqueiraSTP")
config_path <- system.file("config", package = "estatisticapesqueiraSTP")
conf <- estatisticapesqueiraSTP::get_config_from_local(config = config_path)
artfish <- list(
dat = readxl::read_excel(path = file.path(config_path, "artfish.xlsx"), sheet = "dat"),
vars = readxl::read_excel(path = file.path(config_path, "artfish.xlsx"),
sheet = "vars"))
artfish
shiny::shinyApp(ui     = estatisticapesqueiraSTP::create_ui("Estatistica pesqueira STP"),
server = estatisticapesqueiraSTP::create_server(
wd = NULL,
cache = NULL,
last_session = NULL,
local_data_directory = conf$config$local_data_directory,
repository_name = conf$repository_name,
repository_location = conf$repository_location,
forms = conf$forms,
databases = conf$databases,
variables = conf$variables,
config = conf$config,
cleaning_function = conf$cleaning_function,
zenodo = conf$zenodo,
artfish = artfish
),
options = list(launch.browser = TRUE)
)
#' @export
start_interface <- function(){
config_path <- system.file("config", package = "estatisticapesqueiraSTP")
message(config_path)
conf <- estatisticapesqueiraSTP::get_config_from_local(config = config_path)
artfish <- list(
dat = readxl::read_excel(path = file.path(config_path, "artfish.xlsx"), sheet = "dat"),
vars = readxl::read_excel(path = file.path(config_path, "artfish.xlsx"),
sheet = "vars"))
shiny::shinyApp(ui     = estatisticapesqueiraSTP::create_ui("Estatistica pesqueira STP"),
server = estatisticapesqueiraSTP::create_server(
wd = NULL,
cache = NULL,
last_session = NULL,
local_data_directory = conf$config$local_data_directory,
repository_name = conf$repository_name,
repository_location = conf$repository_location,
forms = conf$forms,
databases = conf$databases,
variables = conf$variables,
config = conf$config,
cleaning_function = conf$cleaning_function,
zenodo = conf$zenodo,
artfish = artfish
),
options = list(launch.browser = TRUE)
)
}
start_interface()
