
#' @export
delete_instances <- function(
    kobo,
    forms,
    language,
    zenodo,
    token,
    repository_name
){

  msg <- KobomanageR_msg(language)
  message(msg$START,"\n")

  now   <- gsub(" ", "_", gsub("-", "", gsub(":", "", substr(Sys.time(), 3, 19) )))
  dir.create(file.path(tempdir(), now))
  tempfiles <- file.path(tempdir(), now)


  api <- kobo_projects(url      = kobo[["url"]],
                       username = kobo[["username"]],
                       password = kobo[["password"]])


  old_submissions <-  LOAD_DEPOSITION_FILE(title = repository_name,
                                           token = token,
                                           instance = zenodo[["instance"]],
                                           filename = "submissions.json",
                                           read_function = function(x) {
                                             jsonlite::fromJSON(x, simplifyVector = FALSE)
                                           }
  )

  for(form in names(old_submissions)){
    repo_ids <- unlist(lapply(old_submissions[[form]], function(x) x$'_id'))
    name <- forms[[form]]$name
    if(name %in% api$name) {
      assetid = api$assetid[which(api$name == name)]
      kobo_dat <- kobo_download(url      = kobo[["url"]],
                                username = kobo[["username"]],
                                password = kobo[["password"]],
                                assetid  = assetid,
                                language = language)
      kobo_ids <- unlist(lapply(kobo_dat, function(x) x$'_id'))
      delete_ids <- kobo_ids[kobo_ids %in% repo_ids]
      if(length(delete_ids) > 0)
        kobo_delete_submission(assetid = assetid,
                               username = kobo[["username"]],
                               password = kobo[["password"]],
                               name = name,
                               url = kobo[["url"]],
                               submission_id = delete_ids,
                               language = language)
    }
  }


  message(msg$END,"\n")
}
